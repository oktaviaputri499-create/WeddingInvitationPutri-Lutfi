generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Using sqlite for out-of-the-box running. Change to "postgresql" for production.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Guest {
  id        String   @id @default(uuid())
  name      String
  token     String   @unique
  rsvp      Rsvp?
  wishes    Wish[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Rsvp {
  id             String   @id @default(uuid())
  guestId        String   @unique
  guest          Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  status         String   // "attending", "not_attending", "pending"
  numberOfGuests Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Wish {
  id        String   @id @default(uuid())
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventSettings {
  id               String   @id @default("main")

  groomName        String   @default("Lutfi Arlanda")
  groomParents     String   @default("Bapak Suparlan & Ibu Titik")

  brideName        String   @default("Putri Oktavia")
  brideParents     String   @default("Bapak Supiyanto & Ibu Widaryati")

  weddingDate      String   @default("Sabtu, 7 Juli 2027")
  weddingTime      String   @default("08:00 WIB - Selesai")
  weddingLocation  String   @default("Ngawi, East Java")

  welcomeMessage   String   @default("We would love to celebrate this special day with you")
  giftMessage      String   @default("Tak ada yang lebih berarti bagi kami selain kehadiran dan doa baik Anda. Jika ingin turut berbagi kebahagiaan di hari istimewa ini, dapat melalui:")

  bank1Name        String   @default("Bank BCA")
  bank1Number      String   @default("8268009977")
  bank1Holder      String   @default("Putri Oktavia")

  bank2Name        String   @default("Bank BCA")
  bank2Number      String   @default("7790476390")
  bank2Holder      String   @default("Lutfi Arlanda")

  updatedAt        DateTime @updatedAt
}